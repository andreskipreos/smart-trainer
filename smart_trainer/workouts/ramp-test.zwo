<workout_file>
    <author>smart-trainer</author>
    <name>Ramp Test FTP</name>
    <description>Test de rampa: escalones de 1 minuto que suben 6% FTP hasta el fallo. Tu nuevo FTP ≈ 75% de tu mejor minuto. Usa la tecla q cuando no puedas más.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.40" PowerHigh="0.55"/>
        <SteadyState Duration="60" Power="0.40"/>
